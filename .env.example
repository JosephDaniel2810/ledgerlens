# SEC requires a descriptive User-Agent with a contact email on every request.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="LedgerLens your-name your-email@example.com"

# Where raw filings and processed chunks are written.
LEDGERLENS_DATA_DIR=data

# Postgres + pgvector (started with `docker compose up -d`).
DATABASE_URL=postgresql://ledgerlens:ledgerlens@localhost:5433/ledgerlens

# Local models (downloaded once on first use, run on CPU).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
